extends SceneTree
const Rules = preload("res://scripts/oxygen_rules.gd")

func _initialize() -> void:
	assert(is_equal_approx(Rules.consume_oxygen(100.0, 10.0), 85.0))
	assert(is_equal_approx(Rules.consume_oxygen(4.0, 10.0), 0.0))
	assert(is_equal_approx(Rules.consume_oxygen(100.0, 0.0), 100.0))
	assert(is_equal_approx(Rules.replenish_oxygen(95.0), 100.0))
	assert(is_equal_approx(Rules.replenish_oxygen(40.0), 52.0))
	assert(Rules.can_collect(1.8))
	assert(not Rules.can_collect(1.81))
	assert(not Rules.can_collect(-1.0))
	assert(is_equal_approx(Rules.oxygen_rate_at_depth(10.0), 1.5), "surface uses normal rate")
	assert(is_equal_approx(Rules.oxygen_rate_at_depth(0.0), 2.25), "deeper water increases oxygen use")
	assert(is_equal_approx(Rules.oxygen_rate_at_depth(-100.0), 3.0), "depth multiplier is capped")
	assert(is_equal_approx(Rules.oxygen_rate_at_depth(30.0), 1.5), "above surface never gives negative depth")
	assert(is_equal_approx(Rules.estimated_oxygen_seconds(45.0, 1.5), 30.0), "predictable remaining oxygen")
	assert(is_equal_approx(Rules.estimated_oxygen_seconds(0.0, 1.5), 0.0), "empty oxygen returns zero")
	assert(is_equal_approx(Rules.oxygen_rate_at_depth(INF), 0.0), "nonfinite altitude rejected")
	assert(is_equal_approx(Rules.estimated_oxygen_seconds(40.0, 0.0), 0.0), "zero rate has no estimate")
	var targets: Array[Vector3] = [Vector3(10, 0, 0), Vector3(1, 0, 0), Vector3(-6, 0, 0)]
	assert(Rules.nearest_target_index(Vector3.ZERO, targets) == 1, "nearest pearl selected")
	assert(Rules.nearest_target_index(Vector3.ZERO, []) == -1, "empty sonar field")
	assert(Rules.nearest_target_index(Vector3(INF, 0, 0), targets) == -1, "invalid origin rejected")
	assert(Rules.sonar_direction(Vector3.ZERO, Vector3(0, 5, 0)) == "SUBIR")
	assert(Rules.sonar_direction(Vector3.ZERO, Vector3(0, -5, 0)) == "DESCER")
	assert(Rules.sonar_direction(Vector3.ZERO, Vector3(9, 0, 1)) == "LESTE")
	assert(Rules.sonar_direction(Vector3.ZERO, Vector3(-9, 0, 1)) == "OESTE")
	assert(Rules.sonar_direction(Vector3.ZERO, Vector3(0, 0, -9)) == "NORTE")
	assert(Rules.sonar_direction(Vector3.ZERO, Vector3(0, 0, 9)) == "SUL")
	assert(Rules.sonar_direction(Vector3.ZERO, Vector3.ZERO) == "AQUI")
	assert(is_equal_approx(Rules.consume_oxygen(INF, 1.0), 0.0), "invalid oxygen is rejected")
	assert(is_equal_approx(Rules.consume_oxygen(10.0, NAN), 0.0), "invalid delta is rejected")
	assert(is_equal_approx(Rules.replenish_oxygen(50.0, INF), 0.0), "invalid supply is rejected")
	assert(not Rules.can_collect(INF), "invalid pearl distance is rejected")
	assert(Rules.sonar_relative_direction(Vector3.ZERO, Vector3(0, 0, -10), Vector3(0, 0, -1)) == "FRENTE", "forward")
	assert(Rules.sonar_relative_direction(Vector3.ZERO, Vector3(0, 0, 10), Vector3(0, 0, -1)) == "ATRAS", "behind")
	assert(Rules.sonar_relative_direction(Vector3.ZERO, Vector3(10, 0, 0), Vector3(0, 0, -1)) == "DIREITA", "starboard")
	assert(Rules.sonar_relative_direction(Vector3.ZERO, Vector3(-10, 0, 0), Vector3(0, 0, -1)) == "ESQUERDA", "port")
	assert(Rules.sonar_relative_direction(Vector3.ZERO, Vector3(0, 10, 0), Vector3(0, 0, -1)) == "SUBIR", "rise")
	assert(Rules.sonar_relative_direction(Vector3.ZERO, Vector3(0, -10, 0), Vector3(0, 0, -1)) == "DESCER", "dive")
	assert(Rules.sonar_relative_direction(Vector3.ZERO, Vector3.ZERO, Vector3(0, 0, -1)) == "AQUI", "already there")
	assert(Rules.sonar_relative_direction(Vector3.ZERO, Vector3(0, 0, -10), Vector3.ZERO) == "DESCONHECIDO", "invalid heading")
	print("Oxygen and sonar rules: all 38 assertions passed")
	quit()
